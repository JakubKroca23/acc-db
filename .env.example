# PostgreSQL (katalog). Bez DATABASE_URL API čte scripts/scraped_products.json.
# V Dockeru: host `postgres`. Lokálně s compose postgres: 127.0.0.1:54331
POSTGRES_USER=acc
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=acc_db
DATABASE_URL=postgres://acc:change_me_strong_password@127.0.0.1:54331/acc_db

# Optional: required as X-Update-Token header for POST /api/catalog/update
ACC_DB_UPDATE_TOKEN=change_me_generate_a_long_secret

# Access gate — login of Contsystem Manager (cs-zakazky). Defaults are set in docker-compose.yml;
# local dev keeps it off unless ACC_DB_AUTH=manager.
# ACC_DB_AUTH=manager
# ACC_DB_ALLOWED_ROLES=dev
# MANAGER_APPWRITE_ENDPOINT=https://appwrite.propoj.app/v1
# MANAGER_APPWRITE_PROJECT_ID=contsystem
# MANAGER_SESSION_COOKIE=a_session_contsystem
# MANAGER_LOGIN_URL=/login?next=%2Facc-db%2F
# MANAGER_URL=/
